APP_ENV=dev

POSTGRES_HOST=db
POSTGRES_DB=yii2
POSTGRES_USER=yii2
POSTGRES_PASSWORD=secret
POSTGRES_PORT=5432

NGINX_PORT=8080

# Test-mode shop credentials from https://yookassa.ru/my (merchant dashboard
# -> test shop -> API keys). Leave blank to keep the "fake" gateway as the
# only option in the payment picker.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Robokassa technical settings (merchant dashboard -> Настройки -> Технические
# настройки): MerchantLogin plus the *test* Password #1/#2 pair, kept separate
# from the production passwords by Robokassa itself. ROBOKASSA_TEST_MODE=1
# sends IsTest=1 on every payment link so it's validated against those test
# passwords instead of production ones; flip to 0 only when going live with
# the production password pair.
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_TEST_MODE=1
